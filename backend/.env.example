# Bid2Work AI — Backend Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets to source control.

APP_NAME="Bid2Work AI"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server host & port binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of origins)
# You may also use CORS_ALLOWED_ORIGINS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Upload & PDF Extraction Safeguards
# You may also use MAX_UPLOAD_SIZE_MB
MAX_UPLOAD_MB=25
MAX_BIDDER_FILES=10
MAX_PAGES_PER_PDF=200
TEMP_UPLOAD_DIR=/tmp/bid2work_uploads

# Persistence / SQLite Database Path
# You may also use SQLITE_DB_PATH
DATABASE_URL=./data/bid2work_audit.db

# Authentication & Session Security (Render / Production)
# Set a unique 32+ character random secret key for HMAC-SHA256 JWT signing
SECRET_KEY=bid2work-insecure-dev-key-change-in-production-render-deployment
TOKEN_EXPIRY_HOURS=72

# ---------------------------------------------------------------------------
# External LLM API Integration (Groq / OpenAI-compatible)
# ---------------------------------------------------------------------------
# Mode toggle:
#   LLM_ENABLED=false (default): Mock / deterministic mode. App starts and tests run without any live API key.
#   LLM_ENABLED=true: Live mode. Calls external LLM provider. Requires valid non-placeholder LLM_API_KEY.
LLM_ENABLED=true

# Chosen provider (Groq OpenAI-compatible endpoint)
LLM_PROVIDER=groq

# Live API Key (Must be set by user in .env; never commit real keys to source control)
LLM_API_KEY=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

# Provider Base URL for Groq OpenAI-compatible endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1

# Recommended Groq Model (e.g. llama-3.3-70b-versatile, mixtral-8x7b-32768)
LLM_MODEL=openai/gpt-oss-120b

# Request timeout in seconds (bounded between 5 and 300)
LLM_TIMEOUT_SECONDS=60

# Maximum retry attempts for structured JSON schema validation failures (bounded between 0 and 5)
LLM_MAX_RETRIES=2
